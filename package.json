{
	"name": "widsith-uploader",
	"private": true,
	"version": "0.4.5",
	"type": "module",
	"scripts": {
		"dev": "tauri dev",
		"build": "tauri build",
		"release": "node scripts/need-update-key.mjs && tauri build --ci --config src-tauri/tauri.release.conf.json --features public",
		"ship": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/release.ps1",
		"dev:web": "vite",
		"build:web": "vite build",
		"check": "svelte-check --tsconfig ./tsconfig.json",
		"test": "vitest --run",
		"shared": "node scripts/sync-shared.mjs",
		"app-icon": "node scripts/build-app-icon.mjs",
		"icons": "tauri icon src-tauri/app-icon.png",
		"tray-icon": "node scripts/build-tray-icon.mjs",
		"notices": "node scripts/notices.mjs"
	},
	"dependencies": {
		"@fontsource-variable/fraunces": "^5.3.0",
		"@fontsource-variable/inter": "^5.3.0",
		"@tauri-apps/api": "^2.12.4",
		"@tauri-apps/plugin-autostart": "^2.7.0",
		"@tauri-apps/plugin-dialog": "^2.8.3",
		"@tauri-apps/plugin-http": "^2.8.3",
		"@tauri-apps/plugin-notification": "^2.7.0",
		"@tauri-apps/plugin-opener": "^2.7.2"
	},
	"devDependencies": {
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tauri-apps/cli": "^2.12.4",
		"@types/node": "^22",
		"svelte": "^5.57.2",
		"svelte-check": "4.7.7",
		"typescript": "^6.0.3",
		"vite": "^8.3.5",
		"vitest": "^5.0.5"
	}
}
