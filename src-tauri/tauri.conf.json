{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "Widsith Uploader",
	"version": "0.4.6",
	"identifier": "app.widsith.uploader",
	"build": {
		"beforeDevCommand": "npm run dev:web",
		"devUrl": "http://localhost:1420",
		"beforeBuildCommand": "npm run build:web",
		"frontendDist": "../dist"
	},
	"app": {
		"windows": [
			{
				"label": "main",
				"title": "Widsith Uploader",
				"width": 560,
				"height": 760,
				"minWidth": 520,
				"minHeight": 560,
				"visible": false,
				"useHttpsScheme": true
			}
		],
		"security": {
			"csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: https://*.public.blob.vercel-storage.com; connect-src ipc: http://ipc.localhost"
		}
	},
	"bundle": {
		"active": true,
		"targets": ["nsis"],
		"publisher": "Reflective Grove LLC",
		"copyright": "Copyright (c) 2026 Reflective Grove LLC",
		"shortDescription": "Sends your Widsith recordings to the site after you play.",
		"licenseFile": "../LICENSE.txt",
		"resources": {
			"../LICENSE.txt": "LICENSE.txt",
			"../THIRD-PARTY-NOTICES.txt": "THIRD-PARTY-NOTICES.txt"
		},
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		],
		"windows": {
			"signCommand": {
				"cmd": "powershell",
				"args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "../scripts/sign.ps1", "%1"]
			},
			"nsis": {
				"installMode": "currentUser"
			}
		}
	},
	"plugins": {
		"updater": {
			"pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQyNUEzQUQ2NzJCQUYzODAKUldTQTg3cHkxanBhUXZUM1BJSzVybmt2NHVOWDFpRThlUVBCOURIb2tXYlgySmhobjVwbUVoWDUK",
			"endpoints": ["https://widsith.app/downloads/uploader-update.json"],
			"requireSignedVersion": true,
			"windows": {
				"installMode": "passive"
			}
		}
	}
}
